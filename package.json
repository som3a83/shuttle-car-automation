{
  "name": "shuttle-car-automation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run && npm run test:security",
    "test:security": "node scripts/run-security-tests.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b",
    "validate": "npm audit --audit-level=high && npm run check && npm test && npm run check:release && npm run assets:render && npm run build",
    "assets:render": "node scripts/render-store-assets.mjs",
    "check:release": "node --test scripts/android-release-config.check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "csstype": "3.2.3"
  }
}
