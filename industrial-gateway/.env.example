# Generate two different random secrets. Never commit real secrets.
SHUTTLE_GATEWAY_READ_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SHUTTLE_GATEWAY_INGEST_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Keep loopback unless the OT team approves a protected gateway interface.
SHUTTLE_GATEWAY_BIND=127.0.0.1
SHUTTLE_GATEWAY_PORT=8765
SHUTTLE_GATEWAY_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173
SHUTTLE_GATEWAY_CONFIG=./config.json
SHUTTLE_GATEWAY_DB=./telemetry.sqlite3
